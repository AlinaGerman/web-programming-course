{
  "name": "quiz-backend",
  "type": "module",
  "scripts": {
     "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test:unit": "vitest run --include 'src/**/*.unit.test.ts'",
    "test:feature": "vitest run --include 'src/**/*.feature.test.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:build": "docker build -t quiz-backend:local .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env quiz-backend:local",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down -v",
    "compose:logs": "docker compose logs -f backend",
    "ci:local:linux": "bash ./scripts/local-release.sh",
    "ci:local:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-release.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-release.ps1",
    "rollback": "powershell -ExecutionPolicy Bypass -File .\\scripts\\rollback-local.ps1",
    "release:linux": "bash ./scripts/local-release.sh",
    "rollback:linux": "bash ./scripts/rollback-local.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@prisma/client": "6.19",
    "hono": "^4.11.10",
    "prisma": "6.19",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^8.57.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.1",
    "vitest-mock-extended": "^3.1.0"
  }
}
